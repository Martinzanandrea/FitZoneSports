# Variables opcionales de docker compose (copiar a .env en la raíz).
# Sin este archivo, docker compose usa los valores por defecto de desarrollo.
# Las variables de la API para correrla fuera de Docker están en
# server/.env.example, y las del portal en client/.env.example.

DB_NAME=fitzone
DB_USERNAME=fitzone
DB_PASSWORD=
# Puerto del Postgres en la máquina (5433 para no chocar con uno local)
DB_PUERTO_HOST=5433
JWT_SECRET=

# Opcional: envío real de mails de verificación con una cuenta de Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
