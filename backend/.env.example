NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# false para un Postgres local sin SSL (docker compose); Supabase necesita true
DB_SSL=true

JWT_SECRET=
JWT_EXPIRATION=8h

# Clave privada ES256 con la que se firma el QR de acceso (PEM PKCS8). Permite que
# el terminal verifique el QR sin servidor. Se acepta en una línea con "\n" literales.
# Generarla una sola vez y guardarla como secreto (nunca en el repo):
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Si falta, el QR se firma con HS256 (JWT_SECRET) y el acceso offline no está disponible.
# QR_PRIVATE_KEY=
# Identificador de la clave (opcional). Por defecto: 8 hex de un SHA-256 de la pública.
# QR_KEY_ID=
# Solo desarrollo: sin QR_PRIVATE_KEY, genera un par efímero al arrancar
# (cambia en cada reinicio). docker compose lo activa.
# QR_CLAVE_EFIMERA=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FOTOS=fotos-usuarios
SUPABASE_BUCKET_COMPROBANTES=comprobantes

GMAIL_USER=fitzonesports@gmail.com
GMAIL_APP_PASSWORD=
# Proveedor de correo: brevo (producción / Render) o gmail (desarrollo local).
# Si no se define, se usa gmail. Con brevo son obligatorias BREVO_API_KEY y MAIL_FROM_EMAIL.
MAIL_PROVIDER=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# Pool de conexiones (opcionales; estos son los valores por defecto)
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000
# Solo desarrollo: imprime el link de verificación de email por consola
# MAIL_DEV_LOG_LINKS=false

# Notificaciones push (Web Push con VAPID). Opcionales: si falta alguna, el canal
# PUSH queda deshabilitado y la aplicación arranca igual.
# Generar el par de claves una sola vez con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contacto@ejemplo.com

# Almacenamiento de archivos (fotos y comprobantes): supabase (por defecto) o local.
# Con local se guardan en STORAGE_LOCAL_DIR y se sirven en PUBLIC_API_URL/archivos.
# STORAGE_PROVIDER=supabase
# STORAGE_LOCAL_DIR=archivos
# PUBLIC_API_URL=http://localhost:3000
