{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fitzonesports.onrender.com/:path*" },
    { "source": "/((?!_vercel/|sw\\.js|push-sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|assets/|images/|pwa-.*\\.png|apple-touch-icon\\.png|favicon\\.svg|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/push-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
