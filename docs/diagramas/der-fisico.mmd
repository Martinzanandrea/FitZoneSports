    time hora_inicio UK
    time hora_fin
    estado_ocurrencia_clase estado
    timestamptz creada_en
  }
  clases {
    uuid id PK
    uuid sede_id FK "IDX idx_clases_sede"
    varchar tipo_clase
    uuid instructor_id FK
    int capacidad
    numeric horas_semanales_totales
    bool activa
    timestamptz creada_en
  }
  comprobantes {
    uuid id PK
    uuid pago_id FK,UK
    text pdf_path
    timestamptz generado_en
  }
  control_acceso {
    uuid id PK
    uuid usuario_id FK "UQ parcial RN-01 uq_acceso_abierto_por_usuario"
